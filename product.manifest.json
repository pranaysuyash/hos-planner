{
  "$schema": "https://trucking.platform.io/schemas/subproduct-manifest-v1.json",
  "id": "product-03-hos-planner",
  "name": "HOS Compliance & Interstate Corridor Legality Planner",
  "shortName": "HOS Planner",
  "code": "P03",
  "version": "1.0.0",
  "port": 5175,
  "icon": "⏱️",
  "description": "FMCSA Part 395 statutory hours of service engine, 24-hr ELD logbooks, and corridor simulations",
  "category": "compliance",
  "entitlementKey": "hos_planner",
  "routes": {
    "dev": "http://localhost:5175",
    "cloud": "https://hosdispatch.pages.dev"
  },
  "bridges": {
    "consumes": [
      { "from": "product-04-asset-studio", "protocol": "OLAS-v1", "action": "ingest_vehicle_range" },
      { "from": "product-05-fleet-telematics", "protocol": "TELEMATICS-v1", "action": "ingest_driver_duty_state" }
    ],
    "produces": [
      { "to": "product-05-fleet-telematics", "protocol": "TELEMATICS-v1", "action": "verify_hos_limits" }
    ]
  }
}
